{
  "name": "po-gen-3",
  "version": "0.4.4",
  "description": "DeepSeek Harness 破甲插件「无限三代」：意图化拒绝封禁 + 中途坚持 + 防漂移锚 + 供应商审核对抗 v3 + 再注入顾问，客户端显示「破甲已开启」状态条与四态实时判定。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "HARNESS_PLUGIN.md",
    "README.md",
    "prompts"
  ],
  "scripts": {
    "harness:check": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "id": "dsh-infinite-gen-3",
    "name": "无限三代",
    "version": "0.4.4",
    "repo": "local/gen3-lab",
    "permissions": "系统提示词注入, 客户端状态条, 会话投影, 再注入顾问",
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
