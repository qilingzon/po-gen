{
  "name": "po-gen",
  "version": "0.5.80",
  "description": "DeepSeek Harness 插件「无限5代」：把「破甲模式」注册为可选 agent preset，为选中该预设的会话追加交付引擎系统提示、直接完成型输出规范、长输出落盘纪律与工作提醒顾问；未选中预设的会话零注入。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./preheat": "./preheat.js",
    "./package.json": "./package.json",
    "./dump": "./dump.js"
  },
  "files": [
    "soft-reversal.js",
    "opening.js",
    "preset-rows.js",
    "normalize.js",
    "index.js",
    "preheat.js",
    "client.js",
    "cordis.patch.yml",
    "install.sh",
    "install.ps1",
    "uninstall.sh",
    "uninstall.ps1",
    "HARNESS_PLUGIN.md",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "assets",
    "prompts",
    "dump.js",
    "docs",
    "tools"
  ],
  "scripts": {
    "harness:check": "node --check index.js && node --check client.js && node --check preheat.js && node --check soft-reversal.js",
    "test": "node --test test/*.test.mjs",
    "preset-rows": "node tools/build-preset-rows.mjs",
    "docs:sync": "node tools/sync-install-docs.mjs",
    "pack": "node tools/pack-release.mjs",
    "release:check": "node tools/build-preset-rows.mjs --check && node tools/sync-install-docs.mjs --check && npm test",
    "check:docs": "node tools/check-docs.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "agent-preset",
    "prompt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qilingzon/po-gen.git"
  },
  "homepage": "https://github.com/qilingzon/po-gen#readme",
  "bugs": {
    "url": "https://github.com/qilingzon/po-gen/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.4.0"
  },
  "dsh": {
    "id": "po-gen",
    "name": "无限5代",
    "version": "0.5.80",
    "repo": "https://github.com/qilingzon/po-gen",
    "permissions": "系统提示词注入（仅 armor 预设）, 客户端状态条, 会话投影, 工作提醒顾问",
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
